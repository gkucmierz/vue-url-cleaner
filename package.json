{
  "name": "vue-url-cleaner",
  "version": "1.0.0",
  "description": "Zero-dependency, route-aware URL tracking parameter stripper and query cleaner for Vue 3, Vue Router, and VitePress.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-router",
    "url",
    "cleaner",
    "sanitizer",
    "fbclid",
    "gclid",
    "utm",
    "tracking",
    "privacy",
    "vitepress",
    "router"
  ],
  "author": "Grzegorz Kućmierz <gkucmierz@gmail.com> (https://7u.pl)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitea.7u.pl/gkucmierz/vue-url-cleaner.git"
  },
  "homepage": "https://gitea.7u.pl/gkucmierz/vue-url-cleaner",
  "peerDependencies": {
    "vue": ">=3.0.0",
    "vue-router": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  }
}
